#!/bin/bash
# Quick input method switcher for Google Docs + Vim extension
# Switches between U.S. English and Geez-QWERTY (Amharic)
IM=/etc/profiles/per-user/kirubeltadesse/bin/macism
CURRENT=$($IM)

if [ "$CURRENT" = "com.apple.keylayout.US" ]; then
    $IM com.apple.keylayout.Geez-QWERTY
else
    $IM com.apple.keylayout.US
fi
