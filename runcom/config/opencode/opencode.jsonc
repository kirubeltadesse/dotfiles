{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/hy3-free",
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "permission": {
    "bash": {
      "rm -rf *": "ask",
      "rm -r *": "ask",
      "rm *": "ask",
      "*": "allow",
    },
    "edit": {
      "~/.treehouse/**": "allow",
    },
    "external_directory": {
      "~/.treehouse/**": "allow",
    },
  },
  "watcher": {
    "ignore": ["**/graphify-out/**", "**/graph.json", "**/.graphify_*"],
  },
  "provider": {
    "ollama": {
      "models": {
        "nemotron3:33B": {
          "name": "nemotron3:33B",
        },
        "qwen2.5:7b": {
          "name": "qwen2.5:7b",
        },
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1",
      },
    },
    "relayfast": {
      "name": "relay.fast",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://relay.fast/v1",
        "apiKey": "{file:~/.config/opencode/relay-key}",
      },
      "models": {
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "limit": { "context": 372000, "output": 128000 },
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": { "context": 1000000, "output": 64000 },
        },
        "glm-5.3": {
          "name": "GLM-5.3",
          "limit": { "context": 1000000, "output": 65536 },
        },
        "minimax-m3": {
          "name": "MiniMax M3",
          "limit": { "context": 1000000, "output": 65536 },
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "limit": { "context": 256000, "output": 65536 },
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "limit": { "context": 272000, "output": 128000 },
        },
        "claude-haiku-4-5": {
          "name": "Claude Haiku 4.5",
          "limit": { "context": 200000, "output": 64000 },
        },
        "mimo-v2.5-pro": {
          "name": "MiMo v2.5 Pro",
          "limit": { "context": 1000000, "output": 65536 },
        },
      },
    },
    "openrouter": {
      "models": {
        "~anthropic/claude-sonnet-latest": {
          "options": {
            "provider": {
              "order": ["anthropic"],
              "allow_fallbacks": true,
              "ollama": {
                "models": {
                  "gemma4:26b-mlx": {
                    "_launch": true,
                    "name": "gemma4:26b-mlx",
                  },
                },
                "name": "ollama",
                "npm": "@ai-sdk/openai-compatible",
                "options": {
                  "baseURL": "http://localhost:11434/v1",
                },
              },
            },
          },
        },
      },
    },
  },
  "mcp": {
    "google-calendar": {
      "type": "local",
      "command": [
        "node",
        "/Users/kirubeltadesse/Tools/google-calendar-mcp/build/index.js",
      ],
      "enabled": true,
      "environment": {
        "GOOGLE_OAUTH_CREDENTIALS": "/Users/kirubeltadesse/Tools/google-calendar-mcp/gcp-oauth.keys.json",
      },
    },
    "storybook": {
      "type": "local",
      "command": [
        "node",
        "/Users/kirubeltadesse/projects/soccer-adict-project/mobile-app/scripts/storybook-mcp-bridge.mjs",
      ],
      "enabled": true,
      "environment": {
        "STORYBOOK_URL": "http://localhost:6006",
      },
    },
    "circleci": {
      "type": "local",
      "command": ["circleci", "mcp", "start"],
      "enabled": true,
    },
    "sonarqube": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--init",
        "--pull=always",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG",
        "-e",
        "SONARQUBE_READ_ONLY",
        "sonarsource/sonarqube-mcp",
      ],
      "enabled": true,
      "environment": {
        "SONARQUBE_TOKEN": "{env:SONARQUBE_TOKEN}",
        "SONARQUBE_ORG": "swarmies",
        "SONARQUBE_READ_ONLY": "true",
      },
    },
  },
}
